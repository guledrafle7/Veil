<div class="custom-section full-width">
  {% if section.settings.background_image %}
    <div class="custom-section__background">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag }}
    </div>
  {% endif %}

  <div class="custom-section__content">
    {% content_for 'blocks' %}
  </div>
</div>

<section class="feature-section">
  <div class="feature-list">
    <div class="feature-card">
      <div class="feature-icon">🔥</div>
      <h3>Bold Designs</h3>
      <p>Stand out with playful, cartoonish, and bold streetwear styles.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">🎨</div>
      <h3>Custom Art</h3>
      <p>Unique graphics and illustrations exclusive to VEIL collections.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">🌎</div>
      <h3>Worldwide Shipping</h3>
      <p>Express delivery and easy returns, wherever you are.</p>
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-section {
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  .custom-section__background {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
  }
  .custom-section__background img {
    position: absolute;
    width: 100%;
    height: auto;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .custom-section__content {
    display: grid;
    grid-template-columns: var(--content-grid);
  }
  .custom-section__content > * {
    grid-column: 2;
  }
  .feature-section {
    width: 100%;
    background: rgba(0,0,0,0.7);
    padding: 4rem 0 6rem 0;
    display: flex;
    justify-content: center;
    overflow-x: hidden;
  }
  .feature-list {
    display: flex;
    gap: 2rem;
    max-width: 1100px;
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
  }
  .feature-card {
    background: #181818;
    border-radius: 1.5rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.12);
    padding: 2rem 2rem 1.5rem 2rem;
    color: #fff;
    text-align: center;
    flex: 1 1 0;
    min-width: 220px;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .feature-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .feature-card h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .feature-card p {
    font-size: 1rem;
    opacity: 0.85;
  }
  @media (max-width: 900px) {
    .feature-list {
      flex-direction: column;
      align-items: center;
    }
    .feature-card {
      max-width: 90%;
      margin-bottom: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background"
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_section"
    }
  ]
}
{% endschema %}

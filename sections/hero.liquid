{% comment %}
  Hero Section for VEIL - Modular, bold, and clean
  Uses a customizable background image, heading, tagline, and button
{% endcomment %}

<section class="hero-section full-width">
  <div class="hero-content">
    <div class="hero-tagline hero-tagline--left" aria-label="No Limits." tabindex="0" aria-live="polite">
      <span>N</span><span>o</span> <span>L</span><span>i</span><span>m</span><span>i</span><span>t</span><span>s</span><span>.</span>
    </div>
    <img src="{{ 'Hands.png' | asset_url }}" alt="Hands" class="hero-hands" />
    <div class="hero-tagline hero-tagline--right" aria-label="Just dreams." tabindex="0" aria-live="polite">
      <span>J</span><span>u</span><span>s</span><span>t</span> <span>d</span><span>r</span><span>e</span><span>a</span><span>m</span><span>s</span><span>.</span>
    </div>
  </div>
</section>

{% stylesheet %}
  .hero-section.full-width {
    width: 100vw;
    min-width: 100vw;
    max-width: 100vw;
    margin: 0;
    padding: 0;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    height: calc(100vh - 5rem - 4rem);
    overflow: visible;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    width: 100vw;
    height: 100%;
    padding: 0;
    margin: 0;
    overflow: visible;
  }
.hero-tagline {
  font-family: 'Pally Bold', cursive !important;
  font-size: clamp(3.2rem, 8vw, 7.2rem);
  color: #e0e0e0;
  text-shadow: 0 2px 8px rgba(0,0,0,0.45), 0 1px 0 #888;
  font-weight: normal;
  line-height: 1.05;
  letter-spacing: 0.01em;
  word-spacing: 0.2em;
  user-select: none;
  -webkit-user-select: none;
  -ms-user-select: none;
  -moz-user-select: none;
  width: 100%;
  padding: 0;
  margin: 0;
  transform: translateY(10%);
  overflow: visible;
}
.hero-tagline span {
  display: inline-block;
  transition: transform 0.32s cubic-bezier(0.4, 2, 0.6, 1);
  will-change: transform;
  cursor: pointer;
  --shake-transform: none;
  --contract-transform: none;
  opacity: 0;
  transform: scale(0);
}
.hero-tagline span.pop-in {
  animation: pop-in 1.2s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  pointer-events: none; /* Prevent interaction during pop-in */
}
.hero-tagline span.interactive {
  opacity: 1;
  transform: scale(1);
  transition: transform 0.32s cubic-bezier(0.4, 2, 0.6, 1);
  pointer-events: auto; /* Re-enable interaction */
}
.hero-tagline.shaking span {
  animation: shake 0.4s infinite linear;
  transform: var(--shake-transform, none) !important;
}
.hero-tagline.shaking-fast span {
  animation: shake 0.15s infinite linear;
  transform: var(--shake-transform, none) !important;
}
.hero-tagline.contracting span {
  animation: shake-contract 0.18s infinite linear;
  transform: var(--contract-transform, none) var(--shake-transform, none) !important;
}
@keyframes pop-in {
  0% {
    opacity: 0;
    transform: scale(0);
  }
  30% {
    opacity: 1;
    transform: scale(2.5);
  }
  60% {
    transform: scale(0.7);
  }
  80% {
    transform: scale(1.2);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}
.hero-tagline--left, .hero-tagline--right {
  justify-self: center;
  text-align: center;
  padding: 0;
}
.hero-tagline--right {
  justify-self: center;
  text-align: center;
  padding: 0;
  margin-left: -10%;
}
.hero-hands {
  width: clamp(262px, 45vw, 468px);
  max-width: 100vw;
  height: auto;
  display: block;
  margin: 0 auto;
  justify-self: center;
  opacity: 0;
  transform: scale(0) translateY(-10%);
  transition: transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.6s ease;
}

.hero-hands.interactive {
  transform: scale(1.3) translateY(-10%);
}

.hero-hands.pop-in {
  animation: hands-pop-in 1.2s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}

@keyframes hands-pop-in {
  0% {
    opacity: 0;
    transform: scale(0) translateY(-10%);
  }
  30% {
    opacity: 1;
    transform: scale(1.69) translateY(-10%);
  }
  60% {
    transform: scale(0.5915) translateY(-10%);
  }
  80% {
    transform: scale(1.014) translateY(-10%);
  }
  100% {
    opacity: 1;
    transform: scale(1.3) translateY(-10%);
  }
}



@keyframes shake {
  0% { --shake-transform: translate(0, 0) rotate(0deg); }
  10% { --shake-transform: translate(-2px, 1px) rotate(-2deg); }
  20% { --shake-transform: translate(-1px, -2px) rotate(1deg); }
  30% { --shake-transform: translate(2px, 1px) rotate(2deg); }
  40% { --shake-transform: translate(1px, -1px) rotate(-1deg); }
  50% { --shake-transform: translate(-1px, 2px) rotate(1deg); }
  60% { --shake-transform: translate(-2px, 1px) rotate(-2deg); }
  70% { --shake-transform: translate(2px, 1px) rotate(2deg); }
  80% { --shake-transform: translate(1px, -1px) rotate(-1deg); }
  90% { --shake-transform: translate(-1px, 2px) rotate(1deg); }
  100% { --shake-transform: translate(0, 0) rotate(0deg); }
}
@keyframes shake-contract {
  0% { --shake-transform: translate(0, 0) rotate(0deg); }
  10% { --shake-transform: translate(-1px, 1px) rotate(-4deg); }
  20% { --shake-transform: translate(-2px, -2px) rotate(3deg); }
  30% { --shake-transform: translate(2px, 2px) rotate(4deg); }
  40% { --shake-transform: translate(2px, -1px) rotate(-3deg); }
  50% { --shake-transform: translate(-2px, 2px) rotate(2deg); }
  60% { --shake-transform: translate(-2px, 1px) rotate(-4deg); }
  70% { --shake-transform: translate(2px, 2px) rotate(4deg); }
  80% { --shake-transform: translate(1px, -2px) rotate(-3deg); }
  90% { --shake-transform: translate(-2px, 2px) rotate(2deg); }
  100% { --shake-transform: translate(0, 0) rotate(0deg); }
}
@media (max-width: 900px) {
  .hero-section.full-width {
    height: auto;
    min-height: 60vh;
  }
  .hero-content {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto;
    width: 100vw;
    gap: 2rem;
    padding: 2vw 0;
  }
  .hero-hands {
    width: clamp(150px, 67vw, 262px);
  }
  .hero-tagline {
    font-size: clamp(1.76rem, 9.6vw, 4rem);
    transform: translateY(8%);
  }
  
  /* Adjust parallax effect for tablet */
  .parallax-layer {
    transition: transform 0.08s ease-out;
  }
}
@media (max-width: 600px) {
  .hero-section.full-width {
    height: auto;
    min-height: 40vh;
  }
  .hero-hands {
    width: clamp(94px, 94vw, 169px);
  }
  .hero-tagline {
    font-size: clamp(1.12rem, 12.8vw, 2.24rem);
    transform: translateY(6%);
  }
  
  /* Optimize parallax for mobile device orientation */
  .parallax-layer {
    transition: transform 0.1s ease-out;
  }
}
{% endstylesheet %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const hands = document.querySelector('.hero-hands');
  
  // Random cartoony pop-in animation for all taglines (only on load)
  const allSpans = Array.from(document.querySelectorAll('.hero-tagline span'));
  const maxDelay = 1200 + 100; // Maximum delay for pop-in animation
  
  allSpans.forEach((span, i) => {
    const delay = Math.random() * 1200 + 100; // Random delay between 100-1300ms
    setTimeout(() => {
      span.classList.add('pop-in');
    }, delay);
  });
  
  // Start hands animation at the same time as letters
  setTimeout(() => {
    hands.classList.add('pop-in');
  }, 100); // Start almost immediately with letters
  
  // After all pop-in animations complete, enable interactive effects
  setTimeout(() => {
    // Enable interactive effects for letters
    allSpans.forEach(span => {
      span.classList.remove('pop-in');
      span.classList.add('interactive');
    });
  }, maxDelay + 1200); // Wait for max delay + animation duration

  const taglines = document.querySelectorAll('.hero-tagline');
  taglines.forEach(function(tagline) {
    const spans = tagline.querySelectorAll('span');
    let originalRects = [];
    let parentRect = null;
    let burstOrigin = { x: 0, y: 0 };
    let animating = false;
    let holding = false;
    let docMoveListener = null;

    function storeOriginalRects() {
      originalRects = [];
      parentRect = tagline.getBoundingClientRect();
      spans.forEach(span => {
        const rect = span.getBoundingClientRect();
        originalRects.push(rect);
        span.style.transform = '';
        span.style.setProperty('--contract-transform', 'none');
      });
    }

    function contractToPoint(x, y) {
      if (animating && !holding) return;
      storeOriginalRects();
      tagline.classList.add('contracting');
      burstOrigin = { x, y };
      spans.forEach((span, i) => {
        const rect = originalRects[i];
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const dx = x - centerX;
        const dy = y - centerY;
        // Set the contract transform CSS variable
        span.style.setProperty('--contract-transform', `translate(${dx}px, ${dy}px)`);
      });
    }

    function getExplosionParams() {
      const w = window.innerWidth;
      if (w <= 480) {
        return { baseDistance: 70, extraDistance: 40, minScale: 0.95, maxScale: 1.2 };
      } else if (w <= 700) {
        return { baseDistance: 120, extraDistance: 80, minScale: 1.05, maxScale: 1.5 };
      } else if (w <= 900) {
        return { baseDistance: 180, extraDistance: 120, minScale: 1.1, maxScale: 2.2 };
      } else {
        return { baseDistance: 260, extraDistance: 220, minScale: 1.2, maxScale: 3.4 };
      }
    }

    function burstAndRestore() {
      if (animating) return;
      animating = true;
      tagline.classList.remove('shaking', 'contracting');
      tagline.classList.add('bursting');
      const { baseDistance, extraDistance, minScale, maxScale } = getExplosionParams();
      spans.forEach((span, i) => {
        const angle = Math.random() * 2 * Math.PI;
        const distance = baseDistance + Math.random() * extraDistance;
        const burstX = Math.cos(angle) * distance;
        const burstY = Math.sin(angle) * distance;
        const scale = minScale + Math.random() * (maxScale - minScale);
        span.style.transition = 'transform 0.32s cubic-bezier(0.9,0,0.3,1.3)';
        span.style.transform = `translate(${burstX}px, ${burstY}px) scale(${scale})`;
      });
      spans.forEach((span, i) => {
        setTimeout(() => {
          span.style.transition = 'transform 0.32s cubic-bezier(0.22, 1.5, 0.56, 1)';
          span.style.transform = 'translate(0, 0) scale(1)';
        }, 320 + 180 + i * 60);
      });
      setTimeout(() => {
        tagline.classList.remove('bursting');
        spans.forEach(span => {
          span.style.transition = '';
        });
        animating = false;
      }, 320 + 180 + 320 + spans.length * 60);
    }

    // --- Hover shake effect (only after pop-in animation completes) ---
    tagline.addEventListener('mouseenter', function(e) {
      if (!animating && !holding) {
        const interactiveSpans = tagline.querySelectorAll('span.interactive');
        if (interactiveSpans.length > 0) {
          interactiveSpans.forEach(span => {
            // Add a random animation delay for more natural, non-uniform shake
            span.style.animationDelay = (Math.random() * 0.4).toFixed(3) + 's';
          });
          tagline.classList.add('shaking');
        }
      }
    });
    tagline.addEventListener('mouseleave', function() {
      tagline.classList.remove('shaking', 'shaking-fast');
      // Reset animation delay
      spans.forEach(span => {
        span.style.animationDelay = '';
      });
    });

    // --- Click for faster shaking ---
    tagline.addEventListener('click', function(e) {
      if (!animating && !holding) {
        const interactiveSpans = tagline.querySelectorAll('span.interactive');
        if (interactiveSpans.length > 0) {
          interactiveSpans.forEach(span => {
            // Add a random animation delay for more natural, non-uniform shake
            span.style.animationDelay = (Math.random() * 0.15).toFixed(3) + 's';
          });
          tagline.classList.remove('shaking');
          tagline.classList.add('shaking-fast');
          // Return to normal shaking after 1 second
          setTimeout(() => {
            if (tagline.matches(':hover')) {
              tagline.classList.remove('shaking-fast');
              tagline.classList.add('shaking');
              // Re-randomize delays for normal shake
              interactiveSpans.forEach(span => {
                span.style.animationDelay = (Math.random() * 0.4).toFixed(3) + 's';
              });
            }
          }, 1000);
        }
      }
    });

    // Black hole on click and hold (lock to initial point)
    tagline.addEventListener('mousedown', function(e) {
      if (animating) return;
      const interactiveSpans = tagline.querySelectorAll('span.interactive');
      if (interactiveSpans.length === 0) return; // Only work after pop-in animation
      
      holding = true;
      tagline.classList.remove('shaking');
      tagline.classList.add('contracting');
      storeOriginalRects();
      spans.forEach(span => {
        span.style.transition = 'transform 0.45s cubic-bezier(0.4,2,0.6,1)';
      });
      contractToPoint(e.clientX, e.clientY);
    });

    document.addEventListener('mouseup', function(e) {
      if (holding) {
        holding = false;
        tagline.classList.remove('contracting');
        burstAndRestore();
      }
      if (docMoveListener) {
        document.removeEventListener('mousemove', docMoveListener);
        docMoveListener = null;
      }
    });

    // Mobile tap/hold support (lock to initial point)
    let touchTimeout = null;
    tagline.addEventListener('touchstart', function(e) {
      if (e.touches.length === 1 && !animating) {
        const interactiveSpans = tagline.querySelectorAll('span.interactive');
        if (interactiveSpans.length === 0) return; // Only work after pop-in animation
        
        tagline.classList.remove('shaking');
        tagline.classList.add('contracting');
        storeOriginalRects();
        const touch = e.touches[0];
        touchTimeout = setTimeout(() => {
          holding = true;
          spans.forEach(span => {
            span.style.transition = 'transform 0.45s cubic-bezier(0.4,2,0.6,1)';
          });
          contractToPoint(touch.clientX, touch.clientY);
        }, 120);
      }
    });
    tagline.addEventListener('touchend', function(e) {
      clearTimeout(touchTimeout);
      if (holding) {
        holding = false;
        tagline.classList.remove('contracting');
        burstAndRestore();
      }
    });
    tagline.addEventListener('touchcancel', function(e) {
      clearTimeout(touchTimeout);
      if (holding) {
        holding = false;
        tagline.classList.remove('contracting');
        burstAndRestore();
      }
    });

    // Keyboard accessibility: trigger burst on space/enter
    tagline.addEventListener('keydown', function(e) {
      if ((e.key === ' ' || e.key === 'Enter') && !animating && !holding) {
        const interactiveSpans = tagline.querySelectorAll('span.interactive');
        if (interactiveSpans.length === 0) return; // Only work after pop-in animation
        
        e.preventDefault();
        burstAndRestore();
      }
    });
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "tagline", "label": "Tagline" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %} 
